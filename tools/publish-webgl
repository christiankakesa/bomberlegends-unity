#!/usr/bin/env bash
#
# tools/publish-webgl — build the WebGL release and publish it to playdev-bl.funtest.fr.
#
# The play repo (git@github.com:christiankakesa/bomberlegends-play.git) is a deploy artifact
# repo: its root is the web root, and a push to main triggers a GitHub Action that SSHes to the
# VPS and runs the deploy script there. So publishing is three steps — build, replace, push —
# and this wraps the four ways doing them by hand goes wrong:
#
#   1. The wrong flavour. `unity build webgl` defaults to Development: different artifact names,
#      no Brotli, and a 134 MB .wasm. Copied into the play repo it breaks the page *and* puts
#      134 MB into git history permanently. This builds Release and refuses anything else.
#   2. Deleting the live files before knowing the new ones exist. The old build is the only
#      copy of what is currently served. Nothing is removed until the replacement is verified.
#   3. Losing track of which source commit is live. That is how the site ended up two fixes
#      behind with nobody noticing. The commit message records the source SHA, so
#      `git log -1` in the play repo always answers "what is deployed?".
#   4. Pushing by accident. The push is the step that reaches players, so it is opt-in.
#
# Usage:
#   tools/publish-webgl [--skip-build] [--push] [-m <message>]
#
#   --skip-build   publish the existing Builds/WebGL/Release as-is
#   --push         push to main, which deploys; without it the commit is left local
#   -m             commit subject; the source SHA is appended either way
#
# Set BOMBER_PLAY_REPO to override the play repo location.

set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLAY_REPO="${BOMBER_PLAY_REPO:-/home/christian/workspace/bomber-legends-play}"
BUILD_DIR="$REPO/Builds/WebGL/Release"

# The three entries this script owns in the play repo. Everything else there — .git, .github,
# .gitignore — is infrastructure and must survive the replace.
readonly PAYLOAD=( Build TemplateData index.html )

# A Release WebGL build is ~11 MB. Development is ~145 MB. Anything near the latter means the
# wrong flavour reached the payload, and it must not be committed.
readonly MAX_PAYLOAD_MB=60

die() {
    printf '\n%s: %s\n\n' "$(basename "$0")" "$1" >&2
    exit 1
}

usage() {
    sed -n '3,27p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

step() {
    printf '\n%s\n' "$1"
}

# The source SHA that produced this build, so the play repo can name what it is serving.
source_revision() {
    local sha dirty=''
    sha="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null)" || die "$REPO is not a git repo"
    [[ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]] && dirty=' (dirty tree)'
    printf '%s%s' "$sha" "$dirty"
}

assert_play_repo_publishable() {
    [[ -d $PLAY_REPO ]] || die "no play repo at $PLAY_REPO — set BOMBER_PLAY_REPO"
    git -C "$PLAY_REPO" rev-parse --git-dir >/dev/null 2>&1 || die "$PLAY_REPO is not a git repo"

    local branch
    branch="$(git -C "$PLAY_REPO" branch --show-current)"
    [[ $branch == main ]] || die "play repo is on '$branch'; deploys go from main"

    # Uncommitted work outside the payload is someone else's — a half-finished index.html edit,
    # a workflow change. Replacing files around it would bury it in this commit.
    local stray
    stray="$(git -C "$PLAY_REPO" status --porcelain -- . ':(exclude)Build' ':(exclude)TemplateData' ':(exclude)index.html')"
    if [[ -n $stray ]]; then
        printf '\nuncommitted changes in the play repo, outside the build payload:\n\n' >&2
        printf '%s\n' "$stray" | sed 's/^/  /' >&2
        die "commit or stash them first — this would sweep them into the deploy commit"
    fi
}

# Called before anything is deleted. The currently deployed files are the only copy of what is
# live, so they are not touched until the replacement is known to be complete and the right
# flavour.
assert_build_is_release() {
    [[ -d $BUILD_DIR ]] || die "no release build at ${BUILD_DIR#"$REPO"/} — drop --skip-build"

    local entry
    for entry in "${PAYLOAD[@]}"; do
        [[ -e "$BUILD_DIR/$entry" ]] || die "build is missing $entry — it did not finish"
    done

    compgen -G "$BUILD_DIR/Build/Release.*" >/dev/null \
        || die "no Release.* artifacts in the build — that is a Development build, not a release"

    if compgen -G "$BUILD_DIR/Build/Development.*" >/dev/null; then
        die "Development.* artifacts in the release build — refusing to publish a debug build"
    fi

    local size
    size="$(du -sm "$BUILD_DIR" | cut -f1)"
    if (( size > MAX_PAYLOAD_MB )); then
        die "payload is ${size} MB, over the ${MAX_PAYLOAD_MB} MB ceiling — this looks like a Development build"
    fi
}

replace_payload() {
    local entry
    for entry in "${PAYLOAD[@]}"; do
        rm -rf "${PLAY_REPO:?}/$entry"
        cp -r "$BUILD_DIR/$entry" "$PLAY_REPO/$entry" || die "copy of $entry failed — the play repo is now incomplete, do not push"
    done

    # The build lives on the Windows drive, which reports every file as executable. Copied
    # across as-is, git sees 100644 -> 100755 on all 17 files and commits a "change" with
    # identical blobs — noise that hides whether the build actually moved. These are static web
    # assets; 644 is also what the VPS should be serving.
    chmod -R a-x+X,u=rwX,go=rX "${PAYLOAD[@]/#/$PLAY_REPO/}"
}

main() {
    local skip_build=0 push=0 message=''

    while [[ $# -gt 0 ]]; do
        case "${1:-}" in
            --skip-build) skip_build=1 ;;
            --push)       push=1 ;;
            -m)           shift; message="${1:-}"; [[ -n $message ]] || die "-m needs a message" ;;
            -h|--help)    usage ;;
            *)            die "unknown option $1" ;;
        esac
        shift
    done

    command -v wslpath >/dev/null 2>&1 || die "this expects WSL; the build half drives a Windows Unity.exe"

    local revision
    revision="$(source_revision)"

    assert_play_repo_publishable

    if (( skip_build )); then
        step "reusing existing build in ${BUILD_DIR#"$REPO"/}"
    else
        step "building WebGL release from $REPO"
        "$REPO/tools/unity" build webgl --release || die "build failed — nothing was touched"
    fi

    assert_build_is_release

    step "replacing the deployed build in $PLAY_REPO"
    replace_payload

    git -C "$PLAY_REPO" add -A -- "${PAYLOAD[@]}"

    if git -C "$PLAY_REPO" diff --cached --quiet; then
        step "already up to date — the deployed build matches this one, nothing to commit"
        return 0
    fi

    git -C "$PLAY_REPO" diff --cached --stat | tail -20 | sed 's/^/  /'

    local subject="${message:-deploy WebGL}"
    git -C "$PLAY_REPO" commit -q -m "$subject" -m "Source: bomber-legends@$revision" \
        || die "commit failed"

    step "committed to the play repo:"
    git -C "$PLAY_REPO" log -1 --oneline | sed 's/^/  /'

    if (( push )); then
        step "pushing to main — this deploys to https://playdev-bl.funtest.fr/"
        git -C "$PLAY_REPO" push origin main || die "push failed; the commit is still local"
        printf '\nok  pushed. The GitHub Action deploys from here; watch it finish before testing.\n\n'
    else
        printf '\nok  built, replaced and committed — not pushed.\n'
        printf '    Publish it with:  git -C %s push origin main\n' "$PLAY_REPO"
        printf '    Or re-run this with --push.\n\n'
    fi
}

main "$@"
